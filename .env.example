# ==============================================================================
# AWACH FOUNDATION - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=3000

# Foundation Official Email Addresses
FROM_EMAIL="Awach Foundation" <info@awachfoundation.org>
ADMIN_EMAIL=info@awachfoundation.org

# SMTP Configuration (Uncomment and configure with your real email provider)
# For Gmail, generate an "App Password": https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-character-app-password

# For custom SMTP server:
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@yourdomain.com
# SMTP_PASS=your-password
